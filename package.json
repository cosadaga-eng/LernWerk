{
  "name": "lernwerk",
  "private": true,
  "version": "1.0.0",
  "description": "LernWerk — 100% offline Lernkarten-, Notebook- und Arbeitsblatt-App",
  "author": "LernWerk",
  "homepage": "https://github.com/lernwerk/lernwerk",
  "main": "electron/main.cjs",
  "desktopName": "lernwerk",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "desktop:dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "desktop:preview": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --config electron-builder.yml",
    "desktop:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "desktop:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "desktop:linux": "npm run build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
